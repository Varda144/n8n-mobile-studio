<?xml version="1.0" encoding="utf-8"?>
<!--
  The local runtimes serve plain HTTP on loopback (n8n has no TLS for a phone
  runtime). Cleartext is therefore permitted ONLY for 127.0.0.1/localhost, for
  every other destination the platform default (no cleartext) applies.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
